# ============ gluetun VPN 配置（AIBOX_GATEWAY=gluetun 时使用）============
# 完整文档: https://github.com/qdm12/gluetun-wiki
#
# --- 自建 WireGuard：把 wg0.conf 放到 config/gluetun/wireguard/wg0.conf ---
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
#
# --- 或商业 VPN，例如 Mullvad ---
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=xxx
# WIREGUARD_ADDRESSES=10.64.0.1/32
# SERVER_COUNTRIES=Japan
