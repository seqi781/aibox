# ============ aibox 主配置（KEY=VALUE，不要加 export）============
# 一般不需要手动编辑：aibox init / aibox import 会写好这里需要的内容。

# 网关类型: mihomo（代理订阅 / 分享链接，默认） | gluetun（VPN: WireGuard / OpenVPN）
AIBOX_GATEWAY=mihomo

# ---- mihomo（代理）----
# 节点写在 config/mihomo/upstream.yaml 和 links.txt（用 aibox import 生成）。
# 严格出口：不支持把本机的 Clash / v2rayN 等代理当作上游，节点不能是本机、宿主机或局域网地址。

# 节点筛选正则，例: 日本|JP|Japan（留空 = 全部节点自动择优）
AIBOX_NODE_FILTER=
# 节点选择策略: fallback（出口稳定，推荐） | url-test（最快） | load-balance
AIBOX_GROUP_TYPE=fallback

# ---- 以下为高级选项，通常保持默认 ----
# 默认遮住 /sys 硬件目录，不修改 CPU 架构、内核版本或共享开机标识。
# 需要 GPU / 设备探测等功能的项目可设为 0；重启容器后生效，compare 会显示暴露项。
AIBOX_HIDE_HARDWARE=1
# 时区和语言默认按出口 IP 的地区自动设置；要固定时填写，例: AIBOX_TZ=Asia/Tokyo  AIBOX_LANG=ja_JP.UTF-8
AIBOX_TZ=
AIBOX_LANG=
# 健康检查地址（必须能经代理访问）
AIBOX_TEST_URL=https://www.gstatic.com/generate_204
# 经代理解析的 DNS（DoH，必须带 #PROXY）
AIBOX_PROXY_DNS=https://1.1.1.1/dns-query#PROXY, https://8.8.8.8/dns-query#PROXY
# 仅用于解析代理服务器域名的 DNS（只能直连）
AIBOX_PROXY_SERVER_DNS=https://223.5.5.5/dns-query, https://1.1.1.1/dns-query
# 允许不经代理直连的网段（默认空 = 全部强制走代理）。例: 192.168.1.0/24
AIBOX_ALLOW_DIRECT_CIDRS=
# 把容器里的端口发布到本机 127.0.0.1（开发服务器需监听 0.0.0.0），例: 3000,5173,8080:80
AIBOX_PORTS=
# 额外 apt 包（写入镜像，执行 aibox rebuild 生效），例: golang-go postgresql-client
AIBOX_EXTRA_PACKAGES=
