# ============ aibox 主配置（KEY=VALUE，不要加 export）============

# 网关类型: mihomo（代理/Clash 订阅，默认） | gluetun（VPN: WireGuard/OpenVPN）
AIBOX_GATEWAY=mihomo

# ---- mihomo 模式 ----
# 必须在 config/mihomo/upstream.yaml 中填写远程代理节点或订阅链接，否则拒绝启动。
# 严格出口：不支持把 Mac 上的 Clash 等本地代理作为上游（其规则可能让流量直连），
# 节点地址不能是本机/宿主机/局域网，防火墙也会阻止网关连接这些地址。

# 节点筛选正则，例: 日本|JP|Japan
AIBOX_NODE_FILTER=
# 节点选择策略: fallback（出口稳定，推荐） | url-test（最快） | load-balance
AIBOX_GROUP_TYPE=fallback
# 健康检查地址（必须能经代理访问）
AIBOX_TEST_URL=https://www.gstatic.com/generate_204
# 经代理解析的 DNS（DoH，#PROXY 表示走隧道）
AIBOX_PROXY_DNS=https://1.1.1.1/dns-query#PROXY, https://8.8.8.8/dns-query#PROXY
# 仅用于解析代理服务器域名的 DNS（只能直连）
AIBOX_PROXY_SERVER_DNS=https://223.5.5.5/dns-query, https://1.1.1.1/dns-query

# ---- 通用 ----
# 发布到 Mac 127.0.0.1 的端口（开发服务器需监听 0.0.0.0），例: 3000,5173,8080:80
AIBOX_PORTS=
# 允许不经代理直连的网段（默认空 = 全部强制走代理）。例: 192.168.1.0/24
AIBOX_ALLOW_DIRECT_CIDRS=
# 首次启动自动安装的 AI 工具: claude codex gemini opencode
AIBOX_TOOLS=claude codex
# 时区
AIBOX_TZ=Asia/Shanghai
# 额外 apt 包（写入镜像，执行 aibox rebuild 生效），例: golang-go postgresql-client
AIBOX_EXTRA_PACKAGES=
# 构建镜像时的 Debian 镜像源（构建走宿主机网络），例: http://mirrors.tuna.tsinghua.edu.cn
AIBOX_APT_MIRROR=
