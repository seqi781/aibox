# aibox 全局交互式 shell 配置（位于镜像中，随镜像更新；个人配置请写 ~/.bashrc）
[ -z "${PS1:-}" ] && return

HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

alias ll='ls -alF --color=auto' la='ls -A --color=auto' ls='ls --color=auto' grep='grep --color=auto'

# 提示符在 prompt.sh 里设置；~/.bashrc 的最后一行会再加载一次它，避免被 Debian 默认的 PS1 覆盖
. /etc/aibox/prompt.sh

# 新开的终端窗口显示欢迎信息（子 shell 不重复）
if [ -z "${AIBOX_WELCOMED:-}" ]; then
  export AIBOX_WELCOMED=1
  echo -e "\e[35m[aibox]\e[0m 你在 aibox 容器里（网关 ${AIBOX_GATEWAY:-?}，所有流量经代理）。直接输入 claude / codex 即可（第一次自动安装），exit 退出"
  if [ -n "${AIBOX_MOUNTS:-}" ]; then
    echo "$AIBOX_MOUNTS" | tr ';' '\n' | sed '/^$/d; s/^/  挂载 /'
  else
    echo "  (未挂载任何宿主机目录，编辑 config/mounts.conf 后执行 aibox up)"
  fi
  # （/etc/profile 先读本文件、后读 profile.d，所以这里直接读文件）
  if [ -r "$HOME/.config/aibox/locale.env" ]; then
    echo "  时区 $(sed -n 's/^TZ=//p' "$HOME/.config/aibox/locale.env") · 语言 $(sed -n 's/^LANG=//p' "$HOME/.config/aibox/locale.env")（按出口 IP 地区自动设置）"
  fi
fi
