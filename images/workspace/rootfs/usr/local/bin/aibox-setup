#!/bin/bash
# 安装/升级 AI 编程工具到持久化 home（流量经网关隧道）
#   aibox-setup            安装缺失的工具
#   aibox-setup --upgrade  强制升级到最新
set -uo pipefail
UPGRADE=0; [ "${1:-}" = "--upgrade" ] && UPGRADE=1
TOOLS="${AIBOX_TOOLS:-claude codex}"
rc=0

need() { [ "$UPGRADE" = 1 ] || ! command -v "$1" >/dev/null 2>&1; }

for t in $TOOLS; do
  case "$t" in
    claude)
      if need claude; then
        echo "==> 安装 Claude Code"
        if ! curl -fsSL https://claude.ai/install.sh | bash; then
          echo "    原生安装失败，回退到 npm"
          npm install -g @anthropic-ai/claude-code || rc=1
        fi
      fi ;;
    codex)
      need codex && { echo "==> 安装 Codex CLI"; npm install -g @openai/codex || rc=1; } ;;
    gemini)
      need gemini && { echo "==> 安装 Gemini CLI"; npm install -g @google/gemini-cli || rc=1; } ;;
    opencode)
      need opencode && { echo "==> 安装 opencode"; npm install -g opencode-ai || rc=1; } ;;
    *) echo "未知工具: ${t}（支持 claude codex gemini opencode）"; rc=1 ;;
  esac
done

hash -r
for t in $TOOLS; do
  bin="$t"
  command -v "$bin" >/dev/null 2>&1 && printf '  %-9s %s\n' "$t" "$("$bin" --version 2>/dev/null | head -1)"
done
[ "$rc" = 0 ] && mkdir -p "$HOME/.cache" && touch "$HOME/.cache/aibox-setup.done"
exit "$rc"
